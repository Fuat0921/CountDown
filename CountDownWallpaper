        ], 36),
        mats.shell, mats.lineFaint, 24
      );
      rig.head.add(cranium);

      const visorGeo = new THREE.SphereGeometry(0.152, 32, 24, -Math.PI * 0.36, Math.PI * 0.72, Math.PI * 0.16, Math.PI * 0.66);
      const visor = makeSketchPart(visorGeo, mats.visor, null);
      visor.scale.set(0.88, 1.18, 1.03);
      visor.position.set(0, 0.305, 0.018);
      visor.rotation.y = Math.PI / 2;
      rig.head.add(visor);

      // Iconic curved visor contour line in crisp drafting ink
      const ledPts = [
        new THREE.Vector3(-0.108, 0.395,  0.048),
        new THREE.Vector3(-0.120, 0.340,  0.078),
        new THREE.Vector3(-0.106, 0.268,  0.118),
        new THREE.Vector3(-0.082, 0.205,  0.140),
        new THREE.Vector3(-0.042, 0.166,  0.150),
        new THREE.Vector3( 0.000, 0.158,  0.153),
        new THREE.Vector3( 0.042, 0.166,  0.150),
        new THREE.Vector3( 0.082, 0.205,  0.140),
        new THREE.Vector3( 0.106, 0.268,  0.118),
        new THREE.Vector3( 0.120, 0.340,  0.078),
        new THREE.Vector3( 0.108, 0.395,  0.048)
      ];
      const ledCurve = new THREE.CatmullRomCurve3(ledPts);
      rig.head.add(new THREE.Mesh(new THREE.TubeGeometry(ledCurve, 52, 0.0032, 6, false), mats.ledCore));

      // ---- 4. SKETCHED ARMS & ARTICULATED 5-FINGERED HANDS ----
      function buildArm(side) {
        const shoulder = new THREE.Group();
        shoulder.position.set(side * 0.312, 0.675, -0.008);
