    // Parametric smooth organic loft generator (preserves exact realistic Optimus silhouette)
    function createLoftedGeometry(rings, radialSegs = 40) {
      const positions = [];
      const uvs = [];
      const indices = [];

      for (let i = 0; i < rings.length; i++) {
        const r = rings[i];
        const v = i / (rings.length - 1);
        const rx = r.rx;
        const rz = r.rz;
        const zOff = r.zOff || 0;
        const chest = r.chest || 0;
        const backFlat = r.backFlat || 0;
        const shoulderLift = r.shoulderLift || 0;

        for (let j = 0; j <= radialSegs; j++) {
          const u = j / radialSegs;
          const th = u * Math.PI * 2;
          const c = Math.cos(th);
          const s = Math.sin(th);

          let x = rx * c;
          let z = rz * s + zOff;
          let y = r.y;

          if (s > 0 && chest) {
            const pec = Math.pow(s, 1.4) * (1.0 - 0.18 * Math.exp(-Math.pow(c * 4.5, 2)));
            z += chest * pec;
          }
          if (s < 0 && backFlat) {
            z += backFlat * Math.pow(-s, 1.6);
          }
          if (shoulderLift) {
            y += shoulderLift * Math.pow(Math.abs(c), 2.0);
          }

          positions.push(x, y, z);
          uvs.push(u, v);
        }
      }

      const stride = radialSegs + 1;
      for (let i = 0; i < rings.length - 1; i++) {
        for (let j = 0; j < radialSegs; j++) {
          const a = i * stride + j;
          const b = a + 1;
          const c = (i + 1) * stride + j;
          const d = c + 1;
          indices.push(a, c, b);
          indices.push(b, c, d);
        }
      }

      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
      geo.setIndex(indices);
      geo.computeVertexNormals();
      return geo;
    }

    // Custom GLSL Invisible-Fill Technical Sketch Shader:
    // Draws crisp Fresnel silhouette outlines + delicate Da Vinci diagonal pencil cross-hatching
    // while keeping the interior ghostly/transparent like the math sketches.
    function createSketchShaderMaterial({
      inkHex = 0xeae4d3,
      rimPower = 2.1,
      rimIntensity = 0.72,
      hatchDensity = 34.0,
      hatchIntensity = 0.24,
      baseAlpha = 0.02
    } = {}) {
      return new THREE.ShaderMaterial({
        uniforms: {
          uInk: { value: new THREE.Color(inkHex) },
          uLightDir: { value: new THREE.Vector3(-0.55, 0.72, 0.42).normalize() },
          uRimPower: { value: rimPower },
          uRimIntensity: { value: rimIntensity },
          uHatchDensity: { value: hatchDensity },
          uHatchIntensity: { value: hatchIntensity },
          uBaseAlpha: { value: baseAlpha }
        },
        vertexShader: `
          varying vec3 vNormalView;
          varying vec3 vViewDir;
          varying vec3 vWorldPos;
          void main() {
            vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
            vNormalView = normalize(normalMatrix * normal);
            vViewDir = normalize(-mvPos.xyz);
            vWorldPos = (modelMatrix * vec4(position, 1.0)).xyz;
            gl_Position = projectionMatrix * mvPos;
          }
        `,
        fragmentShader: `
          uniform vec3 uInk;
          uniform vec3 uLightDir;
          uniform float uRimPower;
          uniform float uRimIntensity;
          uniform float uHatchDensity;
          uniform float uHatchIntensity;
          uniform float uBaseAlpha;
          varying vec3 vNormalView;
          varying vec3 vViewDir;
          varying vec3 vWorldPos;

          void main() {
            vec3 N = normalize(vNormalView);
            vec3 V = normalize(vViewDir);
            float ndotv = clamp(abs(dot(N, V)), 0.0, 1.0);

            // Crisp hand-drawn contour silhouette around curved 3D edges
            float rim = pow(1.0 - ndotv, uRimPower);
            float crispEdge = smoothstep(0.55, 0.94, 1.0 - ndotv);

            // Subtle pencil cross-hatching in shadowed folds (Da Vinci drafting feel)
            float ndotl = dot(N, normalize(uLightDir));
            float shade = clamp(0.68 - ndotl * 0.65, 0.0, 1.0);

            float p1 = sin((vWorldPos.x * 1.15 + vWorldPos.y * 1.35 + vWorldPos.z * 0.7) * uHatchDensity);
            float p2 = sin((vWorldPos.x * 1.25 - vWorldPos.y * 1.10 + vWorldPos.z * 0.6) * (uHatchDensity * 0.82));
            float hatch1 = smoothstep(0.76, 0.96, p1) * shade;
            float hatch2 = smoothstep(0.84, 0.98, p2) * smoothstep(0.45, 0.95, shade);

            float alpha = uBaseAlpha
              + rim * uRimIntensity * 0.68
              + crispEdge * uRimIntensity * 0.52
              + (hatch1 * 0.65 + hatch2 * 0.45) * uHatchIntensity;

            if (alpha < 0.025) discard;
            gl_FragColor = vec4(uInk, clamp(alpha, 0.0, 0.78));
          }
        `,
        transparent: true,
        depthWrite: false,
        side: THREE.FrontSide
      });
    }

    // Subtle chalk-ink T E S L A chest lettering
    function createTeslaSketchTexture() {
      const c = document.createElement('canvas');
      c.width = 512;
      c.height = 96;
      const g = c.getContext('2d');
      g.clearRect(0, 0, c.width, c.height);
      g.fillStyle = 'rgba(234, 228, 211, 0.55)';
      g.font = '400 24px "IBM Plex Mono", monospace';
      g.textAlign = 'center';
      g.textBaseline = 'middle';
      ['T', 'E', 'S', 'L', 'A'].forEach((ch, idx) => {
        g.fillText(ch, 116 + idx * 70, 48);
      });
      const tex = new THREE.CanvasTexture(c);
      tex.anisotropy = 4;
      return tex;
    }

