      rig.torso.add(collarYoke);

      // Faint sketched T E S L A mark on chest
      const logoGeo = new THREE.CylinderGeometry(0.245, 0.245, 0.062, 28, 1, true, -0.42, 0.84);
      const logoMesh = new THREE.Mesh(
