    document.getElementById('closeDateEditorBtn').addEventListener('click', () => closeAllPopovers());

    document.getElementById('saveDatesBtn').addEventListener('click', () => {
      document.querySelectorAll('#dateInputsContainer input').forEach(inp => {
        const idx = parseInt(inp.dataset.idx, 10);
        if (inp.value) milestones[idx].date = inp.value;
      });
      saveJSON('aero_milestones_v3', milestones);
      closeAllPopovers();
      updateClockAndCountdown();
      whisper('Milestone dates saved');
    });

    // Today's Plan Menu toggle (Starts ON by default; user can switch OFF or ON anytime)
    let planOpen = loadJSON('aero_plan_open_v4', true);

    function syncPlanMenuUI() {
      document.getElementById('planShelf').classList.toggle('collapsed', !planOpen);
      document.getElementById('planArrow').textContent = planOpen ? '▼' : '▲';

      const badge = document.getElementById('planStatusBadge');
      badge.textContent = planOpen ? 'ON' : 'OFF';
      badge.className = planOpen
        ? 'mono text-[9px] uppercase px-1.5 py-0.5 rounded bg-[#d8a458]/20 text-[#d8a458]'
        : 'mono text-[9px] uppercase px-1.5 py-0.5 rounded bg-white/10 text-[#eae4d3]/45';

      const dotCls = planOpen
        ? 'w-1.5 h-1.5 rounded-full bg-[#d8a458] shadow-[0_0_8px_rgba(216,164,88,0.8)] transition'
        : 'w-1.5 h-1.5 rounded-full bg-[#eae4d3]/30 transition';
      document.getElementById('planTabDot').className = dotCls;
      document.getElementById('planTopDot').className = dotCls;
      document.getElementById('planTopToggleBtn').classList.toggle('active', planOpen);
    }

    function setPlanMenuOpen(next) {
      planOpen = next;
      saveJSON('aero_plan_open_v4', planOpen);
      syncPlanMenuUI();
    }

    document.getElementById('planToggleBtn').addEventListener('click', () => setPlanMenuOpen(!planOpen));
    document.getElementById('planTopToggleBtn').addEventListener('click', () => setPlanMenuOpen(!planOpen));
    document.getElementById('planCloseMenuBtn').addEventListener('click', () => setPlanMenuOpen(false));

    // Zen Mode
    function setZen(on) {
      document.body.classList.toggle('zen-mode', on);
      document.getElementById('uiLayer').classList.toggle('zen-hidden', on);
      if (on) closeAllPopovers();
    }
    document.getElementById('zenBtn').addEventListener('click', () => setZen(true));
    document.getElementById('zenRevealBtn').addEventListener('click', () => setZen(false));

    /*************************************************************************
     * 9. MAIN ANIMATION LOOP
     *************************************************************************/
    let lastTime = 0;
    function animate(ts) {
      const dt = Math.min(0.05, (ts - lastTime) / 1000 || 0.016);
      lastTime = ts;
      const t = ts / 1000;

      // Render background lab (behind engine)
      lctx.clearRect(0, 0, W, H);
      drawFullWidthWaves(lctx, t);
      drawCodeBehindEngine(lctx, dt);
      drawMathSketch(lctx, t, dt);
      drawPhysicsSim(lctx, t, dt);
      drawSnow(lctx, dt);

      // Render 3D engineering robotics blueprints (behind engine)
      updateRobotics3D(t);

      // Render fixed centerpiece jet engine
      drawJetEngine(ectx, dt);
      sound.updateThrottle(currentRpm);

      requestAnimationFrame(animate);
    }

    window.addEventListener('resize', resize);
    window.onload = function () {
      initRobotics3D();
      resize();
      renderPlan();
      syncPlanMenuUI();
      updateThrottleUI();
      updateLayerChips();
      updateClockAndCountdown();
      setInterval(updateClockAndCountdown, 500);
      enableJetAudioOnLoad();
      lastTime = performance.now();
      requestAnimationFrame(animate);
    };
  </script>
</body>
</html>
