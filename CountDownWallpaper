      rig.torso.add(lowerTorso);

      const upperChest = makeSketchPart(
        createLoftedGeometry([
          { y: 0.255, rx: 0.221, rz: 0.151, chest: 0.022, backFlat: 0.018 },
          { y: 0.36,  rx: 0.242, rz: 0.162, chest: 0.032, backFlat: 0.022 },
          { y: 0.49,  rx: 0.268, rz: 0.172, chest: 0.044, backFlat: 0.025 },
