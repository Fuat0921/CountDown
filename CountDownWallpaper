    let activeCodeIdx = 0;
    let codeCharCount = 0;
    let codeHoldTimer = 0;

    function drawCodeBehindEngine(ctx, dt) {
      if (!layers.code) return;
      const snip = CODE_SNIPPETS[activeCodeIdx];
      const fullText = snip.lines.join('\n');

      if (codeCharCount < fullText.length) {
        codeCharCount += dt * 34;
      } else {
        codeHoldTimer += dt;
        if (codeHoldTimer > 5.5) {
          codeHoldTimer = 0;
          codeCharCount = 0;
          activeCodeIdx = (activeCodeIdx + 1) % CODE_SNIPPETS.length;
        }
      }

      const visible = fullText.slice(0, Math.floor(codeCharCount)).split('\n');
      const x = Math.max(24, W * 0.045);
      const y = H * 0.24;

      ctx.save();
      ctx.font = '11px "IBM Plex Mono", monospace';
      ctx.fillStyle = `rgba(216, 164, 88, ${0.34 * labOpacity})`;
      ctx.fillText(`// ${snip.file}`, x, y - 16);

      visible.forEach((line, idx) => {
        const isExec = line.startsWith('[EXEC]');
        ctx.fillStyle = isExec
          ? `rgba(216, 164, 88, ${0.42 * labOpacity})`
          : `rgba(234, 228, 211, ${0.26 * labOpacity})`;
        ctx.fillText(line, x, y + idx * 17);
      });

      // Subtle blinking cursor
      if (Math.floor(performance.now() / 480) % 2 === 0) {
        const lastLine = visible[visible.length - 1] || '';
        const tw = ctx.measureText(lastLine).width;
        ctx.fillStyle = `rgba(216, 164, 88, ${0.5 * labOpacity})`;
        ctx.fillRect(x + tw + 3, y + (visible.length - 1) * 17 - 9, 5, 11);
      }
      ctx.restore();
    }

    /*************************************************************************
     * 4. CHALK MATH GRAPHS & LIVE PHYSICS SIMULATIONS BEHIND ENGINE
     *************************************************************************/
    const MATH_SKETCHES = ['riemann', 'cubic', 'gaussian', 'polar'];
    const PHYSICS_SIMS = ['pendulum', 'projectile', 'aero', 'kepler', 'standing'];

    let mathSlot = { type: 'riemann', age: 0, dur: 15 };
    let physSlot = { type: 'pendulum', age: 4, dur: 16 };

    function randomizeLab() {
      mathSlot = {
        type: MATH_SKETCHES[Math.floor(Math.random() * MATH_SKETCHES.length)],
        age: 0,
        dur: 14 + Math.random() * 5
      };
      physSlot = {
        type: PHYSICS_SIMS[Math.floor(Math.random() * PHYSICS_SIMS.length)],
        age: 0,
        dur: 14 + Math.random() * 5
      };
      activeCodeIdx = (activeCodeIdx + 1) % CODE_SNIPPETS.length;
      codeCharCount = 0;
      codeHoldTimer = 0;
    }

    function chalkAxes(ctx, x, y, w, h, alpha) {
      ctx.strokeStyle = `rgba(234, 228, 211, ${0.24 * alpha})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x, y + h);
      ctx.lineTo(x + w, y + h);
      ctx.moveTo(x, y + h);
      ctx.lineTo(x, y);
      ctx.stroke();
    }

    // Full-width oscillating harmonic & damped wave behind the jet engine
    function drawFullWidthWaves(ctx, t) {
      if (!layers.math) return;
      const cy = H * 0.52;
      const amp = Math.min(95, H * 0.13);

      ctx.save();
      // Primary harmonic wave
      ctx.beginPath();
      for (let x = 0; x <= W; x += 6) {
        const nx = (x / W) * Math.PI * 4;
        const y = cy +
          Math.sin(nx - t * 0.85) * amp * 0.62 +
          Math.sin(nx * 2.1 + t * 0.55) * amp * 0.24;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = `rgba(234, 228, 211, ${0.14 * labOpacity})`;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Secondary damped wave
      ctx.beginPath();
      for (let x = 0; x <= W; x += 6) {
        const u = (x - W * 0.5) / (W * 0.42);
        const env = Math.exp(-u * u * 1.4);
        const y = cy + Math.cos(u * 11 + t * 1.15) * amp * 0.85 * env;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = `rgba(216, 164, 88, ${0.14 * labOpacity})`;
      ctx.lineWidth = 1;
      ctx.stroke();

      // Moving dy/dx tangent point on primary wave
      const px = ((t * 48) % (W * 0.72)) + W * 0.14;
      const nx = (px / W) * Math.PI * 4;
      const py = cy + Math.sin(nx - t * 0.85) * amp * 0.62 + Math.sin(nx * 2.1 + t * 0.55) * amp * 0.24;
      const slope = (Math.cos(nx - t * 0.85) * amp * 0.62 * (Math.PI * 4 / W)) +
                    (Math.cos(nx * 2.1 + t * 0.55) * amp * 0.24 * (Math.PI * 8.4 / W));

      ctx.strokeStyle = `rgba(216, 164, 88, ${0.32 * labOpacity})`;
      ctx.beginPath();
      ctx.moveTo(px - 42, py - slope * 42);
      ctx.lineTo(px + 42, py + slope * 42);
      ctx.stroke();

      ctx.fillStyle = `rgba(216, 164, 88, ${0.55 * labOpacity})`;
      ctx.beginPath();
      ctx.arc(px, py, 2.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.font = '10px "IBM Plex Mono", monospace';
      ctx.fillText(`dy/dx = ${slope.toFixed(2)}`, px + 8, py - 10);
      ctx.restore();
    }

    function drawMathSketch(ctx, t, dt) {
      if (!layers.math) return;
      mathSlot.age += dt;
      if (mathSlot.age > mathSlot.dur) {
        mathSlot.age = 0;
        mathSlot.type = MATH_SKETCHES[(MATH_SKETCHES.indexOf(mathSlot.type) + 1) % MATH_SKETCHES.length];
      }
      const fade = Math.min(1, mathSlot.age / 1.5, (mathSlot.dur - mathSlot.age) / 1.5);
      const a = Math.max(0, fade) * labOpacity;

      const x = Math.max(24, W * 0.048);
      const y = H * 0.56;
      const w = Math.min(220, W * 0.2);
      const h = 110;

      ctx.save();
      ctx.font = '10px "IBM Plex Mono", monospace';
      ctx.fillStyle = `rgba(234, 228, 211, ${0.34 * a})`;

      if (mathSlot.type === 'riemann') {
        chalkAxes(ctx, x, y, w, h, a);
        const bars = 10;
        for (let i = 0; i < bars; i++) {
          const u = (i + 0.5) / bars;
          const val = Math.sin(u * Math.PI) * (0.65 + 0.25 * Math.sin(t * 1.1 + i * 0.35));
          const bh = Math.max(6, val * (h - 14));
          ctx.strokeStyle = `rgba(216, 164, 88, ${0.26 * a})`;
          ctx.strokeRect(x + i * (w / bars) + 2, y + h - bh, w / bars - 4, bh);
        }
        ctx.fillText('∫₀^π sin(x) dx ≈ Σ f(xᵢ)Δx', x, y - 10);
      } else if (mathSlot.type === 'cubic') {
        chalkAxes(ctx, x, y, w, h, a);
        ctx.beginPath();
        for (let i = 0; i <= w; i += 3) {
          const u = (i / w) * 2 - 1;
          const cy = y + h * 0.5 - (u * u * u - 0.6 * u * Math.cos(t * 0.7)) * (h * 0.42);
          if (i === 0) ctx.moveTo(x + i, cy);
          else ctx.lineTo(x + i, cy);
        }
        ctx.strokeStyle = `rgba(234, 228, 211, ${0.34 * a})`;
        ctx.stroke();
        ctx.fillText('f(x) = x³ - ax   f′(x) = 3x² - a', x, y - 10);
      } else if (mathSlot.type === 'gaussian') {
        chalkAxes(ctx, x, y, w, h, a);
        const sigma = 0.22 + 0.08 * Math.sin(t * 0.8);
        ctx.beginPath();
        for (let i = 0; i <= w; i += 3) {
          const u = (i / w) - 0.5;
          const val = Math.exp(-(u * u) / (2 * sigma * sigma));
          const py = y + h - val * (h - 14);
          if (i === 0) ctx.moveTo(x + i, py);
          else ctx.lineTo(x + i, py);
        }
        ctx.strokeStyle = `rgba(234, 228, 211, ${0.34 * a})`;
        ctx.stroke();
        ctx.fillText(`N(μ, σ²)  σ = ${sigma.toFixed(2)}`, x, y - 10);
      } else {
        const cx = x + w * 0.48, cy = y + h * 0.52, R = h * 0.44;
        ctx.beginPath();
        for (let th = 0; th <= Math.PI * 2; th += 0.04) {
          const r = R * Math.cos(3 * th + t * 0.4);
          const px = cx + r * Math.cos(th);
          const py = cy + r * Math.sin(th);
          if (th === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = `rgba(216, 164, 88, ${0.32 * a})`;
        ctx.stroke();
        ctx.fillText('r(θ) = a·cos(3θ)', x, y - 10);
      }
      ctx.restore();
    }

    function drawPhysicsSim(ctx, t, dt) {
      if (!layers.physics) return;
      physSlot.age += dt;
      if (physSlot.age > physSlot.dur) {
        physSlot.age = 0;
        physSlot.type = PHYSICS_SIMS[(PHYSICS_SIMS.indexOf(physSlot.type) + 1) % PHYSICS_SIMS.length];
      }
      const fade = Math.min(1, physSlot.age / 1.5, (physSlot.dur - physSlot.age) / 1.5);
      const a = Math.max(0, fade) * labOpacity;

      const w = Math.min(230, W * 0.22);
      const x = W - w - Math.max(24, W * 0.048);
      const y = H * 0.30;
      const h = 130;

      ctx.save();
      ctx.font = '10px "IBM Plex Mono", monospace';
      ctx.fillStyle = `rgba(234, 228, 211, ${0.34 * a})`;

      if (physSlot.type === 'pendulum') {
        const px = x + w * 0.5, py = y + 14;
        const L = 86;
        const theta = 0.62 * Math.cos(t * 2.1);
        const bx = px + Math.sin(theta) * L;
        const by = py + Math.cos(theta) * L;

        ctx.strokeStyle = `rgba(234, 228, 211, ${0.22 * a})`;
        ctx.beginPath();
        ctx.moveTo(px - 24, py); ctx.lineTo(px + 24, py);
        ctx.stroke();

        ctx.strokeStyle = `rgba(234, 228, 211, ${0.36 * a})`;
        ctx.beginPath();
        ctx.moveTo(px, py); ctx.lineTo(bx, by);
        ctx.stroke();

        ctx.fillStyle = `rgba(216, 164, 88, ${0.52 * a})`;
        ctx.beginPath();
        ctx.arc(bx, by, 5.5, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = `rgba(234, 228, 211, ${0.34 * a})`;
        ctx.fillText('F = -mg·sin(θ)', x + 12, y + h);
        ctx.fillText(`θ = ${(theta * 57.3).toFixed(1)}°`, x + 12, y + h + 15);
      } else if (physSlot.type === 'projectile') {
        chalkAxes(ctx, x, y, w, h - 10, a);
        const u = (t * 0.45) % 1;
        ctx.beginPath();
        for (let s = 0; s <= 1; s += 0.04) {
          const px = x + s * (w - 10);
          const py = y + (h - 10) - (4 * s * (1 - s)) * (h - 30);
          if (s === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = `rgba(234, 228, 211, ${0.22 * a})`;
        ctx.setLineDash([3, 3]);
        ctx.stroke();
        ctx.setLineDash([]);

        const px = x + u * (w - 10);
        const py = y + (h - 10) - (4 * u * (1 - u)) * (h - 30);
        ctx.fillStyle = `rgba(216, 164, 88, ${0.55 * a})`;
        ctx.beginPath();
        ctx.arc(px, py, 3.5, 0, Math.PI * 2);
        ctx.fill();

        // Velocity vectors vx, vy
        ctx.strokeStyle = `rgba(216, 164, 88, ${0.42 * a})`;
        ctx.beginPath();
        ctx.moveTo(px, py); ctx.lineTo(px + 22, py);
        ctx.moveTo(px, py); ctx.lineTo(px, py - (1 - 2 * u) * 24);
        ctx.stroke();

        ctx.fillStyle = `rgba(234, 228, 211, ${0.34 * a})`;
        ctx.fillText('y(t) = v₀y·t - ½gt²', x, y - 10);
      } else if (physSlot.type === 'aero') {
        const cx = x + w * 0.5, cy = y + h * 0.5;
        // Airfoil / aero body
        ctx.strokeStyle = `rgba(234, 228, 211, ${0.36 * a})`;
        ctx.beginPath();
        ctx.ellipse(cx, cy, 40, 12, -0.1, 0, Math.PI * 2);
        ctx.stroke();

        // Force vectors: Lift, Drag, Thrust, Weight
        ctx.strokeStyle = `rgba(216, 164, 88, ${0.42 * a})`;
        ctx.beginPath();
        ctx.moveTo(cx, cy); ctx.lineTo(cx, cy - 42); // Lift
        ctx.moveTo(cx, cy); ctx.lineTo(cx + 50, cy); // Thrust
        ctx.moveTo(cx, cy); ctx.lineTo(cx - 38, cy); // Drag
        ctx.stroke();

        ctx.fillText('L = ½ρv²SC_L', cx - 28, cy - 48);
        ctx.fillText('F_d = ½ρC_dAv²', x + 10, y + h);
      } else if (physSlot.type === 'kepler') {
        const cx = x + w * 0.5, cy = y + h * 0.5;
        const rx = 74, ry = 42;
        ctx.strokeStyle = `rgba(234, 228, 211, ${0.24 * a})`;
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
        ctx.stroke();

        const fx = cx - 28, fy = cy;
        ctx.fillStyle = `rgba(216, 164, 88, ${0.5 * a})`;
        ctx.beginPath();
        ctx.arc(fx, fy, 4, 0, Math.PI * 2);
        ctx.fill();

        const ang = t * 1.1;
        const px = cx + Math.cos(ang) * rx;
        const py = cy + Math.sin(ang) * ry;
        ctx.beginPath();
        ctx.moveTo(fx, fy); ctx.lineTo(px, py);
        ctx.strokeStyle = `rgba(216, 164, 88, ${0.28 * a})`;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(px, py, 3, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = `rgba(234, 228, 211, ${0.34 * a})`;
        ctx.fillText('dA/dt = L / 2m = const', x + 12, y + h);
      } else {
        // Standing wave harmonics
        const cy = y + h * 0.5;
        ctx.beginPath();
        for (let i = 0; i <= w; i += 3) {
          const u = i / w;
          const py = cy + Math.sin(u * Math.PI * 3) * Math.cos(t * 3.2) * 32;
          if (i === 0) ctx.moveTo(x + i, py);
          else ctx.lineTo(x + i, py);
        }
        ctx.strokeStyle = `rgba(216, 164, 88, ${0.38 * a})`;
        ctx.stroke();
        ctx.fillText('λ = 2L / n   v = fλ', x + 12, y + h);
      }
      ctx.restore();
    }

    function drawSnow(ctx, dt) {
      if (!layers.snow) return;
      ctx.save();
      for (let i = 0; i < snowParticles.length; i++) {
        const p = snowParticles[i];
        p.x += (p.vx + Math.sin(performance.now() * 0.001 + p.phase) * 6 + mouseNX * 8) * dt;
        p.y += (p.vy + mouseNY * 4) * dt;
        if (p.x < -8) p.x = W + 8;
        if (p.x > W + 8) p.x = -8;
        if (p.y > H + 8) { p.y = -8; p.x = Math.random() * W; }

        ctx.fillStyle = `rgba(234, 228, 211, ${p.alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    /*************************************************************************
     * 5. FIXED CENTERPIECE BLUEPRINT JET ENGINE CANVAS
     *************************************************************************/
    let rotorAngle = 0;

    function drawJetEngine(ctx, dt) {
      ctx.clearRect(0, 0, W, H);
      currentRpm += (targetRpm - currentRpm) * Math.min(1, dt * 2.5);
      rotorAngle += dt * (1.2 + currentRpm * 4.4);

      const cx = W * 0.5;
      const cy = H * 0.54;
      const R = Math.min(W, H) * 0.255;

      ctx.save();
      ctx.translate(cx, cy);

      // Subtle compass / protractor degree ring outside casing
      ctx.strokeStyle = 'rgba(234, 228, 211, 0.11)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(0, 0, R * 1.18, 0, Math.PI * 2);
      ctx.stroke();

      for (let deg = 0; deg < 360; deg += 15) {
        const rad = (deg * Math.PI) / 180;
        const len = deg % 45 === 0 ? 9 : 4;
        ctx.beginPath();
        ctx.moveTo(Math.cos(rad) * (R * 1.18), Math.sin(rad) * (R * 1.18));
        ctx.lineTo(Math.cos(rad) * (R * 1.18 + len), Math.sin(rad) * (R * 1.18 + len));
        ctx.stroke();
      }

      // Semi-translucent dark core so math waves & code peek through behind blades
      const coreGrad = ctx.createRadialGradient(0, 0, R * 0.12, 0, 0, R * 1.02);
      coreGrad.addColorStop(0, 'rgba(13, 17, 22, 0.52)');
      coreGrad.addColorStop(0.75, 'rgba(17, 21, 26, 0.36)');
      coreGrad.addColorStop(1, 'rgba(17, 21, 26, 0.05)');
      ctx.fillStyle = coreGrad;
      ctx.beginPath();
      ctx.arc(0, 0, R * 1.02, 0, Math.PI * 2);
      ctx.fill();

      // Outer nacelle rings
      ctx.strokeStyle = 'rgba(234, 228, 211, 0.34)';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.arc(0, 0, R, 0, Math.PI * 2);
      ctx.stroke();

      ctx.strokeStyle = 'rgba(216, 164, 88, 0.26)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(0, 0, R * 0.94, 0, Math.PI * 2);
      ctx.stroke();

      // Counter-rotating subtle stator vanes in back
      ctx.save();
      ctx.rotate(-rotorAngle * 0.15);
      ctx.strokeStyle = 'rgba(234, 228, 211, 0.11)';
      ctx.lineWidth = 1;
      for (let i = 0; i < 18; i++) {
        const a = (i / 18) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(Math.cos(a) * R * 0.26, Math.sin(a) * R * 0.26);
        ctx.lineTo(Math.cos(a + 0.15) * R * 0.92, Math.sin(a + 0.15) * R * 0.92);
        ctx.stroke();
      }
      ctx.restore();

      // Primary spinning swept turbofan blades
      const blades = 24;
      ctx.save();
      ctx.rotate(rotorAngle);

      for (let i = 0; i < blades; i++) {
        const a = (i / blades) * Math.PI * 2;
        ctx.save();
        ctx.rotate(a);

        // Swept blade polygon
        ctx.beginPath();
        ctx.moveTo(R * 0.22, -3);
        ctx.quadraticCurveTo(R * 0.56, -12, R * 0.92, -6);
        ctx.lineTo(R * 0.92, 5);
        ctx.quadraticCurveTo(R * 0.56, -2, R * 0.22, 4);
        ctx.closePath();

        ctx.fillStyle = 'rgba(234, 228, 211, 0.08)';
        ctx.fill();
        ctx.strokeStyle = i % 6 === 0
          ? 'rgba(216, 164, 88, 0.42)'
          : 'rgba(234, 228, 211, 0.26)';
        ctx.lineWidth = 1;
        ctx.stroke();

        ctx.restore();
      }

      // Spinner hub & spiral paint mark
      ctx.fillStyle = 'rgba(17, 21, 26, 0.85)';
      ctx.strokeStyle = 'rgba(234, 228, 211, 0.46)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(0, 0, R * 0.22, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Classic jet spinner spiral
      ctx.strokeStyle = 'rgba(216, 164, 88, 0.72)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let s = 0; s < 26; s++) {
        const frac = s / 25;
        const r = frac * R * 0.17;
        const ang = frac * Math.PI * 2.4;
        const px = Math.cos(ang) * r;
        const py = Math.sin(ang) * r;
        if (s === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.stroke();
      ctx.restore();

      // Faint blueprint callout ticks
      ctx.font = '9px "IBM Plex Mono", monospace';
      ctx.fillStyle = 'rgba(234, 228, 211, 0.35)';
      ctx.strokeStyle = 'rgba(234, 228, 211, 0.2)';
      ctx.lineWidth = 1;

      const callouts = [
        { ang: -0.65, label: 'INTAKE' },
        { ang: 0.55,  label: 'STATOR' },
        { ang: 2.55,  label: 'JET ENGINE' },
        { ang: -2.45, label: 'EXHAUST' }
      ];
      callouts.forEach(c => {
        const x1 = Math.cos(c.ang) * (R * 1.03);
        const y1 = Math.sin(c.ang) * (R * 1.03);
        const x2 = Math.cos(c.ang) * (R * 1.24);
        const y2 = Math.sin(c.ang) * (R * 1.24);
        const dir = x2 >= 0 ? 1 : -1;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.lineTo(x2 + dir * 24, y2);
        ctx.stroke();
        ctx.textAlign = dir > 0 ? 'left' : 'right';
        ctx.fillText(c.label, x2 + dir * 28, y2 + 3);
      });

      ctx.restore();
    }

    /*************************************************************************
     * 6. PROCEDURAL JET TURBINE + WARM LO-FI RHODES AUDIO ENGINE
     *************************************************************************/
    class AmbientSoundEngine {
      constructor() {
        this.ctx = null;
        this.playing = false;
        this.jetVol = 0.55;
        this.lofiVol = 0.45;
        this.lofiDucked = false;
        this.timer = null;
        this.chordIdx = 0;
      }

      init() {
        const AC = window.AudioContext || window.webkitAudioContext;
        this.ctx = new AC();

        this.master = this.ctx.createGain();
        this.master.gain.value = 0.0001;
        this.master.connect(this.ctx.destination);

        // Jet bus
        this.jetBus = this.ctx.createGain();
        this.jetBus.gain.value = this.jetVol;
        this.jetBus.connect(this.master);

        // Lo-Fi bus
        this.lofiBus = this.ctx.createGain();
        this.lofiBus.gain.value = this.lofiVol;
        this.lofiBus.connect(this.master);

        // Pink noise buffer for jet airflow rumble
        const len = this.ctx.sampleRate * 3;
        const buf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);
        const d = buf.getChannelData(0);
        let b0 = 0, b1 = 0, b2 = 0;
        for (let i = 0; i < len; i++) {
          const w = Math.random() * 2 - 1;
          b0 = 0.997 * b0 + w * 0.029;
          b1 = 0.985 * b1 + w * 0.032;
          b2 = 0.950 * b2 + w * 0.048;
          d[i] = (b0 + b1 + b2 + w * 0.015) * 0.6;
        }

        const noise = this.ctx.createBufferSource();
        noise.buffer = buf;
        noise.loop = true;

        this.jetFilter = this.ctx.createBiquadFilter();
        this.jetFilter.type = 'lowpass';
        this.jetFilter.frequency.value = 340;
        this.jetFilter.Q.value = 1.2;

        noise.connect(this.jetFilter);
        this.jetFilter.connect(this.jetBus);
        noise.start();

        // Subtle turbine whine harmonic
        this.turbineOsc = this.ctx.createOscillator();
        this.turbineOsc.type = 'sine';
        this.turbineOsc.frequency.value = 118;
        this.turbineGain = this.ctx.createGain();
        this.turbineGain.gain.value = 0.035;
        this.turbineOsc.connect(this.turbineGain);
        this.turbineGain.connect(this.jetBus);
        this.turbineOsc.start();
      }

      updateThrottle(rpm) {
        if (!this.ctx || !this.playing) return;
        const now = this.ctx.currentTime;
        this.jetFilter.frequency.setTargetAtTime(220 + rpm * 260, now, 0.3);
        this.turbineOsc.frequency.setTargetAtTime(86 + rpm * 68, now, 0.3);
        this.turbineGain.gain.setTargetAtTime(0.02 + rpm * 0.025, now, 0.3);
      }

      playChord() {
        if (!this.ctx || !this.playing || this.lofiDucked || this.lofiVol <= 0.01) return;
        const chords = [
          [174.61, 220.00, 261.63, 329.63], // Fmaj7
          [164.81, 196.00, 246.94, 293.66], // Em7
          [146.83, 174.61, 220.00, 261.63], // Dm7
          [130.81, 196.00, 246.94, 293.66]  // Cmaj9
        ];
        const notes = chords[this.chordIdx % chords.length];
        this.chordIdx++;
        const now = this.ctx.currentTime;

        notes.forEach((freq, i) => {
          const osc = this.ctx.createOscillator();
          const filter = this.ctx.createBiquadFilter();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.value = freq;
          filter.type = 'lowpass';
          filter.frequency.value = 680;

          const start = now + i * 0.04;
          gain.gain.setValueAtTime(0.0001, start);
          gain.gain.linearRampToValueAtTime(0.045, start + 0.14);
          gain.gain.exponentialRampToValueAtTime(0.0001, start + 4.4);

          osc.connect(filter);
          filter.connect(gain);
          gain.connect(this.lofiBus);
          osc.start(start);
          osc.stop(start + 4.5);
        });
      }

      startLoop() {
        clearInterval(this.timer);
        this.playChord();
        this.timer = setInterval(() => this.playChord(), 4600);
      }

      async start() {
        try {
          if (!this.ctx) this.init();
          if (this.ctx.state === 'suspended') {
            await this.ctx.resume().catch(() => {});
          }
          if (!this.playing) {
            this.playing = true;
            const now = this.ctx.currentTime;
            this.master.gain.cancelScheduledValues(now);
            this.master.gain.setTargetAtTime(0.85, now, 0.4);
            this.startLoop();
          }
          return this.playing;
        } catch (err) {
          console.error('Audio init failed:', err);
          return false;
        }
      }

      stop() {
        if (!this.ctx) return false;
        this.playing = false;
        clearInterval(this.timer);
        const now = this.ctx.currentTime;
        this.master.gain.cancelScheduledValues(now);
        this.master.gain.setTargetAtTime(0.0001, now, 0.25);
        return false;
      }

      setJetVol(v) {
        this.jetVol = v;
        if (this.jetBus && this.ctx) this.jetBus.gain.setTargetAtTime(v, this.ctx.currentTime, 0.1);
      }

      setLofiVol(v) {
        this.lofiVol = v;
        if (this.lofiBus && this.ctx && !this.lofiDucked) {
          this.lofiBus.gain.setTargetAtTime(v, this.ctx.currentTime, 0.1);
        }
      }

      setLofiDucked(duck) {
        this.lofiDucked = duck;
        if (this.lofiBus && this.ctx) {
          this.lofiBus.gain.setTargetAtTime(duck ? 0.0001 : this.lofiVol, this.ctx.currentTime, 0.15);
        }
      }
    }

