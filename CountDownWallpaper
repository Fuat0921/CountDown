        ring.rotation.x = -Math.PI / 2;
        ring.position.y = -1.78;
        root.add(ring);
        rig.halos.push(ring);
      });

      // ---- 1. SCULPTED PELVIS & HIP ACTUATOR SKETCH ----
      rig.pelvis = new THREE.Group();
      rig.pelvis.position.y = -0.10;
      root.add(rig.pelvis);

      const pelvisBridge = makeSketchPart(
        createLoftedGeometry([
          { y: -0.12, rx: 0.19, rz: 0.12, zOff: -0.01 },
