      rig.head.add(neckMesh);

      const cranium = makeSketchPart(
        createLoftedGeometry([
          { y: 0.125, rx: 0.072, rz: 0.085, zOff:  0.022 },
          { y: 0.175, rx: 0.108, rz: 0.126, zOff:  0.020 },
          { y: 0.255, rx: 0.132, rz: 0.156, zOff:  0.008 },
          { y: 0.340, rx: 0.136, rz: 0.160, zOff: -0.004 },
