      rig.torso.add(waistLine);

      const collarYoke = makeSketchPart(
        createLoftedGeometry([
          { y: 0.685, rx: 0.274, rz: 0.150, chest: 0.016, backFlat: 0.020 },
          { y: 0.745, rx: 0.252, rz: 0.132, chest: 0.008, backFlat: 0.016, shoulderLift: -0.02 },
          { y: 0.805, rx: 0.145, rz: 0.105 },
