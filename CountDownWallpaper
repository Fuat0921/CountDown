    function resizeRobotics3D() {
      if (!roboticsReady || !rRenderer || !rCamera) return;
      const w = window.innerWidth;
      const h = window.innerHeight;
      rCamera.aspect = w / h;
      rCamera.updateProjectionMatrix();
      rRenderer.setSize(w, h, false);

      const spread = Math.min(2.45, Math.max(1.38, (w / h) * 1.38));
      if (humanoidRig) humanoidRig.root.position.x = spread;
      if (gearRig) gearRig.root.position.x = -spread * 0.98;
      if (armRig) armRig.root.position.x = -spread * 1.24;
    }

    function updateRobotics3D(t) {
      if (!roboticsReady || !rRenderer) return;
      const rCanvas = document.getElementById('robotics-canvas');
      if (!layers.robotics) {
        rCanvas.style.opacity = '0';
        return;
      }
      // Subtle ghostly sketch opacity matching the math/physics chalk drawings
      rCanvas.style.opacity = String(Math.min(0.72, labOpacity * 0.68));

      // Gentle 3D camera parallax
      rCamera.position.x += (mouseNX * 0.34 - rCamera.position.x) * 0.04;
      rCamera.position.y += (0.28 - mouseNY * 0.16 - rCamera.position.y) * 0.04;
      rCamera.lookAt(0, -0.05, 0);

      // ---- Animate Sketched Optimus Humanoid ----
      if (humanoidRig) {
        const g = t * 1.15;
        const stride = Math.sin(g);
        const oppStride = Math.sin(g + Math.PI);

        humanoidRig.pelvis.position.y = -0.10 + Math.abs(Math.cos(g)) * 0.032;
        humanoidRig.pelvis.rotation.y = stride * 0.05;
        humanoidRig.torso.rotation.y = -stride * 0.08;
        humanoidRig.torso.rotation.x = 0.03 + Math.sin(t * 0.9) * 0.015;
        humanoidRig.root.rotation.y = -0.38 + Math.sin(t * 0.24) * 0.24;

        humanoidRig.head.rotation.y = Math.sin(t * 0.55) * 0.24;
        humanoidRig.head.rotation.x = Math.sin(t * 0.38) * 0.06;

        humanoidRig.legL.hip.rotation.x = stride * 0.22;
        humanoidRig.legL.knee.rotation.x = Math.max(0.04, -Math.cos(g) * 0.32 + 0.10);
        humanoidRig.legL.ankle.rotation.x = -humanoidRig.legL.hip.rotation.x * 0.45;

        humanoidRig.legR.hip.rotation.x = oppStride * 0.22;
        humanoidRig.legR.knee.rotation.x = Math.max(0.04, -Math.cos(g + Math.PI) * 0.32 + 0.10);
        humanoidRig.legR.ankle.rotation.x = -humanoidRig.legR.hip.rotation.x * 0.45;

        const inspect = Math.max(0, Math.sin(t * 0.34));
        humanoidRig.armR.shoulder.rotation.x = stride * 0.18;
        humanoidRig.armR.shoulder.rotation.z = 0.06;
        humanoidRig.armR.elbow.rotation.x = -0.22 - Math.max(0, -stride) * 0.22;

        humanoidRig.armL.shoulder.rotation.x = oppStride * 0.15 * (1 - inspect) - inspect * 0.55;
        humanoidRig.armL.shoulder.rotation.z = -0.06 - inspect * 0.12;
        humanoidRig.armL.elbow.rotation.x = -0.22 - inspect * 0.78;
        humanoidRig.armL.wrist.rotation.y = Math.sin(t * 1.25) * 0.42 * inspect;

        humanoidRig.fingersL.forEach(f => {
          const curl = 0.18 + 0.46 * (0.5 + 0.5 * Math.sin(t * 2.0 + f.idx * 0.5));
          f.prox.rotation.x = -curl;
          if (f.dist) f.dist.rotation.x = -curl * 0.8;
        });
        humanoidRig.fingersR.forEach(f => {
          const curl = 0.14 + 0.24 * (0.5 + 0.5 * Math.sin(t * 1.5 + f.idx * 0.45));
          f.prox.rotation.x = -curl;
          if (f.dist) f.dist.rotation.x = -curl * 0.75;
        });
      }

      // ---- Animate Da Vinci Lead-Screw & Meshing Spur-Gear Mechanism ----
      if (gearRig) {
        const spin = t * (0.38 + currentRpm * 0.28);
        gearRig.screwGroup.rotation.y = spin * 1.6;
        gearRig.mainGear.rotation.y = spin * 0.65;
        gearRig.lowerGear.rotation.y = -spin * 0.85;
        gearRig.pinion.rotation.y = -spin * 1.52;
        gearRig.root.rotation.y = 0.35 + Math.sin(t * 0.22) * 0.16;
      }

      // ---- Animate Sketched 6-DOF Engineering Arm ----
      if (armRig) {
        armRig.turret.rotation.y = Math.sin(t * 0.40) * 0.75;
        armRig.j1.rotation.z = -0.22 + Math.sin(t * 0.60) * 0.24;
        armRig.j2.rotation.z = -0.82 + Math.cos(t * 0.68) * 0.38;
        armRig.wrist.rotation.y = t * 0.85;
        const grip = 0.030 + (0.5 + 0.5 * Math.sin(t * 1.5)) * 0.028;
        armRig.jawL.position.x = -grip;
        armRig.jawR.position.x = grip;
      }

      rRenderer.render(rScene, rCamera);
    }

