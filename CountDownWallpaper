      logoMesh.position.set(0, 0.615, -0.026);
      rig.torso.add(logoMesh);

      // ---- 3. SCULPTED HEAD, VISOR & SKETCHED LED CONTOUR ----
      rig.head = new THREE.Group();
      rig.head.position.y = 0.855;
      rig.torso.add(rig.head);

      const neckMesh = makeSketchPart(
        createLoftedGeometry([
          { y: -0.03, rx: 0.102, rz: 0.098, zOff: -0.005 },
          { y:  0.06, rx: 0.082, rz: 0.084, zOff: -0.004 },
          { y:  0.14, rx: 0.090, rz: 0.096, zOff:  0.004 }
