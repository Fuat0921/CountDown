<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Road Nationals & Finals — MacBook Countdown Lock Screen</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;1,400&family=Inter:wght@300;400;500;600&family=Oswald:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-slate: #11151a;
      --bg-oxblood: #2a1016;
      --ink: #eae4d3;
      --ink-dim: rgba(234, 228, 211, 0.56);
      --brass: #d8a458;
      --spotify: #1DB954;
      --hairline: rgba(234, 228, 211, 0.14);
      --glass: rgba(17, 21, 26, 0.62);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: radial-gradient(circle at 72% 88%, rgba(74, 20, 32, 0.55) 0%, rgba(17, 21, 26, 0.96) 56%, #0c1014 100%);
      color: var(--ink);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
      user-select: none;
    }

    /* Blueprint grid with subtle parallax */
    #blueprint-grid {
      position: fixed;
      inset: -24px;
      z-index: 1;
      pointer-events: none;
      background-image:
        linear-gradient(to right, rgba(234, 228, 211, 0.036) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(234, 228, 211, 0.036) 1px, transparent 1px),
        linear-gradient(to right, rgba(234, 228, 211, 0.016) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(234, 228, 211, 0.016) 1px, transparent 1px);
      background-size: 96px 96px, 96px 96px, 24px 24px, 24px 24px;
      transition: transform 0.25s ease-out;
    }

    /* Subtle editorial paper grain */
    .paper-grain {
      position: fixed;
      inset: 0;
      z-index: 4;
      pointer-events: none;
      opacity: 0.045;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    /* Faint bottom winter pine silhouette */
    .pine-horizon {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      height: 82px;
      z-index: 2;
      pointer-events: none;
      opacity: 0.16;
    }

    /* Canvas stack: Lab behind engine (z:2), Engine centerpiece (z:3) */
    #bg-lab-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
    }

    #robotics-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
    }

    #engine-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 3;
      pointer-events: none;
    }

    .mono { font-family: 'IBM Plex Mono', monospace; }
    .display { font-family: 'Oswald', sans-serif; }

    .ui-layer {
      position: fixed;
      inset: 0;
      z-index: 10;
      pointer-events: none;
    }

    .hide-in-zen {
      transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .ui-layer.zen-hidden .hide-in-zen {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translateY(-4px);
    }

    .pill {
      background: var(--glass);
      border: 1px solid var(--hairline);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .pill-btn {
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      cursor: pointer;
    }
    .pill-btn:hover {
      background: rgba(234, 228, 211, 0.09);
      color: var(--ink);
    }
    .pill-btn.active {
      color: var(--ink);
    }

    /* Compact Spotify button accent */
    #spotifyBtn {
      color: rgba(234, 228, 211, 0.72);
    }
    #spotifyBtn:hover,
    #spotifyBtn.active {
      color: var(--spotify);
      background: rgba(29, 185, 84, 0.12);
    }

    /* Animated mini equalizer bars for active Spotify song */
    @keyframes eqBounce {
      0%, 100% { transform: scaleY(0.3); }
      50% { transform: scaleY(1); }
    }
    .eq-bar {
      width: 2px;
      height: 10px;
      background: var(--spotify);
      border-radius: 99px;
      transform-origin: bottom;
      animation: eqBounce 0.75s ease-in-out infinite;
    }
    .eq-bar:nth-child(2) { animation-delay: 0.2s; }
    .eq-bar:nth-child(3) { animation-delay: 0.4s; }

    .clock-glow {
      text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55);
    }

    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: rgba(234, 228, 211, 0.18);
      height: 3px;
      border-radius: 999px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--ink);
      cursor: pointer;
    }

    /* Plan shelf slide */
    #planShelf {
      transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
    }
    #planShelf.collapsed {
      transform: translateY(calc(100% + 20px));
      opacity: 0;
      pointer-events: none;
    }

    /* Zen reveal corner */
    #zenRevealBtn {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    body.zen-mode #zenRevealZone:hover #zenRevealBtn,
    body.zen-mode #zenRevealBtn:focus {
      opacity: 1;
      pointer-events: auto;
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(234, 228, 211, 0.2); border-radius: 999px; }
  </style>
</head>
<body>

  <!-- Blueprint Grid Layer -->
  <div id="blueprint-grid"></div>

  <!-- Background Lab Canvas (Math Graphs + Physics + Dev Code + Snow) -->
  <canvas id="bg-lab-canvas"></canvas>

  <!-- 3D Engineering Robotics Blueprint Canvas (Behind Jet Engine) -->
  <canvas id="robotics-canvas"></canvas>

  <!-- Faint Winter Pine Horizon -->
  <svg class="pine-horizon" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
    <path fill="#eae4d3" d="M0,90 L0,76 L18,52 L28,74 L46,42 L58,76 L84,56 L96,78 L128,46 L142,80 L190,82 L212,50 L226,80 L255,62 L270,84 L360,86 L390,54 L406,84 L438,60 L452,86 L580,88 L610,64 L624,86 L790,88 L820,56 L836,84 L868,48 L886,84 L922,60 L936,86 L1080,86 L1106,44 L1124,82 L1154,54 L1170,82 L1204,38 L1224,80 L1266,52 L1284,82 L1328,46 L1348,80 L1392,58 L1412,84 L1440,66 L1440,90 Z"/>
  </svg>

  <!-- Fixed Centerpiece Blueprint Jet Engine Canvas -->
  <canvas id="engine-canvas"></canvas>

  <!-- Subtle Paper Grain -->
  <div class="paper-grain"></div>

  <!-- Zen Reveal Corner -->
  <div id="zenRevealZone" class="fixed top-0 right-0 w-36 h-20 z-30 flex items-start justify-end p-4">
    <button id="zenRevealBtn" class="pill px-3 py-1.5 rounded-full text-xs text-[#eae4d3]/90 hover:bg-white/10 cursor-pointer">
      Show UI
    </button>
  </div>

  <!-- Main UI Layer -->
  <div id="uiLayer" class="ui-layer flex flex-col justify-between p-4 sm:p-6">

    <!-- Top Row -->
    <div class="relative w-full flex items-start justify-between">

      <!-- Left: Compact Throttle Switch -->
      <div class="hide-in-zen pointer-events-auto hidden md:flex items-center gap-1 pill rounded-full p-1 text-[10px] mono tracking-wider text-[#eae4d3]/60">
        <button data-throttle="idle" class="throttle-btn px-2.5 py-1 rounded-full pill-btn">IDLE</button>
        <button data-throttle="cruise" class="throttle-btn px-2.5 py-1 rounded-full pill-btn">CRUISE</button>
        <button data-throttle="afterburner" class="throttle-btn px-2.5 py-1 rounded-full pill-btn">MAX</button>
      </div>

      <!-- Center: Natural macOS Lock Screen Clock + Borderless Countdown -->
      <div class="mx-auto text-center pt-1 sm:pt-2 pointer-events-auto">
        <div id="lockDate" class="text-sm sm:text-base font-medium tracking-wide text-[#eae4d3]/90 clock-glow">
          Saturday, November 21
        </div>
        <div id="lockClock" class="text-6xl sm:text-7xl md:text-8xl font-semibold tracking-tight leading-none text-[#eae4d3] clock-glow mt-0.5">
          8:09
        </div>
        <div class="mt-2.5 flex items-center justify-center gap-2 text-xs sm:text-sm text-[#eae4d3]/80 clock-glow">
          <button id="cycleTargetBtn" title="Click to switch milestone" class="mono tracking-wide hover:text-[#d8a458] transition cursor-pointer">
            <span id="countdownText">ROAD NATIONALS · 14d 11h 50m 12s</span>
          </button>
          <button id="editDateBtn" class="hide-in-zen text-[11px] text-[#eae4d3]/45 hover:text-[#eae4d3] underline underline-offset-2 transition cursor-pointer">
            edit
          </button>
        </div>
      </div>

      <!-- Right: Minimalist Control Pill (Audio + Short Spotify Icon + Settings + Hide UI) -->
      <div class="hide-in-zen pointer-events-auto flex items-center gap-1 pill rounded-full px-1.5 py-1">
        <!-- Jet + Music Audio Toggle -->
        <button id="audioToggleBtn" class="pill-btn flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs text-[#eae4d3]/80" title="Toggle Jet Engine & Lo-Fi Audio">
          <span id="audioDot" class="w-1.5 h-1.5 rounded-full bg-[#d8a458]"></span>
          <span class="hidden sm:inline">Jet</span>
        </button>

        <!-- Today's Plan Menu ON/OFF Toggle -->
        <button id="planTopToggleBtn" class="pill-btn active flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs text-[#eae4d3]/90" title="Toggle Today's Plan Menu">
          <span id="planTopDot" class="w-1.5 h-1.5 rounded-full bg-[#d8a458] shadow-[0_0_8px_rgba(216,164,88,0.8)]"></span>
          <span class="hidden sm:inline">Plan</span>
        </button>

        <!-- Short & Clean Spotify Icon -->
        <button id="spotifyBtn" class="pill-btn w-7 h-7 rounded-full flex items-center justify-center" title="Spotify Mini-Player" aria-label="Spotify Mini-Player">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 1.5C6.2 1.5 1.5 6.2 1.5 12S6.2 22.5 12 22.5 22.5 17.8 22.5 12 17.8 1.5 12 1.5zm4.81 15.14a.75.75 0 01-1.03.25c-2.82-1.72-6.37-2.11-10.55-1.15a.75.75 0 01-.33-1.46c4.58-1.05 8.5-.6 11.66 1.33.36.22.47.68.25 1.03zm1.28-2.86a.94.94 0 01-1.29.31c-3.23-1.98-8.15-2.56-11.97-1.4a.94.94 0 11-.55-1.8c4.36-1.32 9.78-.68 13.5 1.6.44.27.58.85.31 1.29zm.11-2.98c-3.87-2.3-10.26-2.51-13.96-1.39a1.12 1.12 0 11-.65-2.15c4.25-1.29 11.31-1.04 15.76 1.6a1.12 1.12 0 11-1.15 1.94z"/>
          </svg>
        </button>

        <!-- Settings Sliders -->
        <button id="settingsBtn" class="pill-btn w-7 h-7 rounded-full flex items-center justify-center text-[#eae4d3]/75" title="Lab & Audio Settings" aria-label="Settings">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
          </svg>
        </button>

        <!-- Hide UI -->
        <button id="zenBtn" class="pill-btn px-2.5 py-1 rounded-full text-xs text-[#eae4d3]/65" title="Zen Mode">
          Hide
        </button>
      </div>
    </div>

    <!-- Compact Spotify Mini-Player Popover -->
    <div id="spotifyPopover" class="hide-in-zen hidden fixed top-16 right-4 sm:right-6 w-[308px] pill rounded-2xl p-3 pointer-events-auto text-xs text-[#eae4d3] z-30 shadow-2xl">
      <!-- Header: Brand + Login + Close -->
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#1DB954]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1.5C6.2 1.5 1.5 6.2 1.5 12S6.2 22.5 12 22.5 22.5 17.8 22.5 12 17.8 1.5 12 1.5zm4.81 15.14a.75.75 0 01-1.03.25c-2.82-1.72-6.37-2.11-10.55-1.15a.75.75 0 01-.33-1.46c4.58-1.05 8.5-.6 11.66 1.33.36.22.47.68.25 1.03zm1.28-2.86a.94.94 0 01-1.29.31c-3.23-1.98-8.15-2.56-11.97-1.4a.94.94 0 11-.55-1.8c4.36-1.32 9.78-.68 13.5 1.6.44.27.58.85.31 1.29zm.11-2.98c-3.87-2.3-10.26-2.51-13.96-1.39a1.12 1.12 0 11-.65-2.15c4.25-1.29 11.31-1.04 15.76 1.6a1.12 1.12 0 11-1.15 1.94z"/>
          </svg>
          <span class="font-medium tracking-wide text-[#eae4d3]">Spotify</span>
          <span id="spotifyUserBadge" class="hidden mono text-[9px] px-1.5 py-0.5 rounded bg-[#1DB954]/20 text-[#1DB954]"></span>
        </div>
        <div class="flex items-center gap-2">
          <button id="spotifyLoginToggleBtn" class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 hover:bg-[#1DB954]/25 hover:text-[#1DB954] transition cursor-pointer">
            Log in
          </button>
          <button id="closeSpotifyBtn" class="text-[#eae4d3]/50 hover:text-[#eae4d3] cursor-pointer">✕</button>
        </div>
      </div>

      <!-- Collapsible Login / Account Sync Panel -->
      <div id="spotifyLoginPanel" class="hidden mb-2.5 p-2.5 rounded-xl bg-black/35 border border-white/10 space-y-2">
        <div class="flex items-center justify-between gap-2">
          <span class="text-[10px] text-[#eae4d3]/70">Full-length playback:</span>
          <a href="https://accounts.spotify.com/login" target="_blank" rel="noopener noreferrer"
             class="px-2.5 py-1 rounded-full bg-[#1DB954] text-[#0c1014] font-semibold text-[10px] hover:brightness-110 transition">
            Sign in to Spotify ↗
          </a>
        </div>
        <form id="spotifyOAuthForm" class="flex gap-1.5 pt-1 border-t border-white/10">
          <input id="spotifyClientIdInput" type="text" placeholder="Optional PKCE Client ID (sync top tracks)"
            class="flex-1 bg-white/5 border border-white/10 rounded-lg px-2 py-1 text-[10px] text-[#eae4d3] placeholder-[#eae4d3]/35 focus:outline-none focus:border-[#1DB954]/50" />
          <button type="submit" class="px-2 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-[10px] cursor-pointer">Sync</button>
        </form>
        <button id="spotifyLogoutBtn" class="hidden w-full py-1 rounded-lg bg-red-500/15 hover:bg-red-500/25 text-red-300 text-[10px] cursor-pointer">
          Disconnect Account
        </button>
      </div>

      <!-- Compact 80px Spotify Embed -->
      <div class="rounded-xl overflow-hidden bg-black/40 border border-white/10 mb-2">
        <iframe id="spotifyIframe"
          style="border-radius:12px"
          src="https://open.spotify.com/embed/track/4cOdK2wGLETKBW3PvgPWqT?utm_source=generator&theme=0"
          width="100%" height="80" frameBorder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
      </div>

      <!-- Category Pills -->
      <div class="grid grid-cols-3 gap-1 mb-2">
        <button data-sp-cat="focus" class="sp-cat-btn py-1 rounded-lg bg-[#1DB954]/20 text-[#1DB954] text-[10px] font-medium transition cursor-pointer">Focus</button>
        <button data-sp-cat="synth" class="sp-cat-btn py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[#eae4d3]/75 text-[10px] font-medium transition cursor-pointer">Aero Synth</button>
        <button data-sp-cat="lofi" class="sp-cat-btn py-1 rounded-lg bg-white/5 hover:bg-white/10 text-[#eae4d3]/75 text-[10px] font-medium transition cursor-pointer">Late Study</button>
      </div>

      <!-- Interactive Scrollable Song List -->
      <div id="spotifyTrackList" class="max-h-32 overflow-y-auto space-y-1 pr-1 mb-2"></div>

      <!-- Custom Spotify URL Loader -->
      <form id="spotifyUrlForm" class="flex gap-1.5 mb-2">
        <input id="spotifyUrlInput" type="text" placeholder="Paste Spotify track / playlist URL..."
          class="flex-1 bg-white/5 border border-white/10 rounded-lg px-2 py-1 text-[10px] text-[#eae4d3] placeholder-[#eae4d3]/35 focus:outline-none focus:border-[#1DB954]/50" />
        <button type="submit" class="px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-[10px] cursor-pointer">Load</button>
      </form>

      <!-- Mute Lo-Fi while keeping Jet Engine -->
      <button id="duckLofiBtn" class="w-full py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[10px] text-[#eae4d3]/80 transition cursor-pointer">
        Mute Lo-Fi (Keep Jet Engine)
      </button>
    </div>

    <!-- Settings & Lab Popover -->
    <div id="settingsPopover" class="hide-in-zen hidden fixed top-16 right-4 sm:right-6 w-72 pill rounded-2xl p-4 pointer-events-auto text-xs text-[#eae4d3] z-30 shadow-2xl">
      <div class="flex items-center justify-between mb-3">
        <span class="font-medium tracking-wide">Lab & Audio Controls</span>
        <button id="closeSettingsBtn" class="text-[#eae4d3]/50 hover:text-[#eae4d3] cursor-pointer">✕</button>
      </div>

      <div class="space-y-3 mb-3.5">
        <div>
          <div class="flex justify-between mb-1 text-[11px] text-[#eae4d3]/75">
            <span>Jet Engine Volume</span>
            <span id="jetVolVal" class="mono">55%</span>
          </div>
          <input id="jetVolSlider" type="range" min="0" max="1" step="0.02" value="0.55" class="w-full" />
        </div>
        <div>
          <div class="flex justify-between mb-1 text-[11px] text-[#eae4d3]/75">
            <span>Lo-Fi Rhodes Volume</span>
            <span id="lofiVolVal" class="mono">45%</span>
          </div>
          <input id="lofiVolSlider" type="range" min="0" max="1" step="0.02" value="0.45" class="w-full" />
        </div>
        <div>
          <div class="flex justify-between mb-1 text-[11px] text-[#eae4d3]/75">
            <span>Background Lab Opacity</span>
            <span id="labOpacityVal" class="mono">85%</span>
          </div>
          <input id="labOpacitySlider" type="range" min="0.15" max="1" step="0.05" value="0.85" class="w-full" />
        </div>
      </div>

      <div class="border-t border-white/10 pt-3 mb-3">
        <div class="text-[10px] mono uppercase tracking-wider text-[#eae4d3]/50 mb-2">Background Layers</div>
        <div class="grid grid-cols-2 gap-1.5">
          <button data-layer="robotics" class="layer-chip py-1.5 rounded-lg text-[11px]">3D Robotics</button>
          <button data-layer="math" class="layer-chip py-1.5 rounded-lg text-[11px]">Math Graphs</button>
          <button data-layer="physics" class="layer-chip py-1.5 rounded-lg text-[11px]">Physics Sims</button>
          <button data-layer="code" class="layer-chip py-1.5 rounded-lg text-[11px]">Live Code</button>
          <button data-layer="snow" class="layer-chip col-span-2 py-1.5 rounded-lg text-[11px]">❄ Winter Snow</button>
        </div>
      </div>

      <div class="flex gap-1.5">
        <button id="randomizeLabBtn" class="flex-1 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-[11px] transition cursor-pointer">
          ↻ Randomize Lab
        </button>
        <button id="fullscreenBtn" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 text-[11px] transition cursor-pointer">
          Fullscreen
        </button>
      </div>
    </div>

    <!-- Inline Milestone Date Editor Popover -->
    <div id="dateEditorPopover" class="hide-in-zen hidden fixed top-36 left-1/2 -translate-x-1/2 w-80 pill rounded-2xl p-4 pointer-events-auto text-xs text-[#eae4d3] z-30 shadow-2xl">
      <div class="flex items-center justify-between mb-3">
        <span class="font-medium">Edit Milestone Dates</span>
        <button id="closeDateEditorBtn" class="text-[#eae4d3]/50 hover:text-[#eae4d3] cursor-pointer">✕</button>
      </div>
      <div id="dateInputsContainer" class="space-y-2.5"></div>
      <button id="saveDatesBtn" class="mt-3.5 w-full py-2 rounded-xl bg-[#d8a458]/25 hover:bg-[#d8a458]/35 text-[#eae4d3] font-medium transition cursor-pointer">
        Save Dates
      </button>
    </div>

    <!-- Bottom Area: Today's Plan Menu Dock (Open by default, toggleable ON / OFF) -->
    <div class="hide-in-zen w-full flex flex-col items-center pointer-events-none">
      <!-- Compact Toggle Tab (always accessible to turn menu ON or OFF) -->
      <button id="planToggleBtn" class="pointer-events-auto pill px-3.5 py-1 rounded-full text-[11px] text-[#eae4d3]/90 hover:bg-white/10 transition flex items-center gap-2 cursor-pointer mb-2 shadow-lg">
        <span id="planTabDot" class="w-1.5 h-1.5 rounded-full bg-[#d8a458] shadow-[0_0_8px_rgba(216,164,88,0.8)]"></span>
        <span class="font-medium tracking-wide">Today's Plan</span>
