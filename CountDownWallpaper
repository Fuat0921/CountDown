        const hipRing = makeDraftCircle(0.115, mats.lineBrass, 32);
        hipRing.rotation.y = Math.PI / 2;
        hipRing.position.set(side * 0.23, -0.055, 0.005);
        rig.pelvis.add(hipRing);

        const hipSocket = makeSketchPart(new THREE.CylinderGeometry(0.088, 0.095, 0.16, 20), mats.inner, mats.lineInk, 26);
