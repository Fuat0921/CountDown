    // Helper: creates an invisible-fill sketch mesh with optional technical edge lines
    function makeSketchPart(geo, mat, edgeMat = null, edgeAngle = 22) {
      const mesh = new THREE.Mesh(geo, mat);
      if (edgeMat) {
        const edges = new THREE.EdgesGeometry(geo, edgeAngle);
        mesh.add(new THREE.LineSegments(edges, edgeMat));
      }
      return mesh;
    }

    // Helper: faint drafting construction circle for joints & exploded CAD accents
    function makeDraftCircle(radius, mat, segs = 48) {
      const pts = [];
      for (let i = 0; i <= segs; i++) {
        const a = (i / segs) * Math.PI * 2;
        pts.push(new THREE.Vector3(Math.cos(a) * radius, Math.sin(a) * radius, 0));
      }
      return new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), mat);
    }

    // Build realistic sculpted Tesla Optimus humanoid in ghostly technical pencil-sketch style
    function buildOptimusHumanoid(mats) {
      const root = new THREE.Group();
      const rig = { root, fingersL: [], fingersR: [], halos: [] };

      // Ground blueprint calibration rings + crosshairs (like Da Vinci drafting circles)
