    /*************************************************************************
     * 2B. 3D TECHNICAL PENCIL-SKETCH OPTIMUS HUMANOID & GEAR MACHINE
     *     (Invisible-fill Fresnel contours, pen cross-hatching & moving gears)
     *************************************************************************/
    let rRenderer = null, rScene = null, rCamera = null;
