        const shRing = makeDraftCircle(0.095, mats.lineBrass, 28);
        shRing.rotation.y = Math.PI / 2;
        shoulder.add(shRing);

        const upperArm = makeSketchPart(
          createLoftedGeometry([
            { y: -0.455, rx: 0.058, rz: 0.060 },
            { y: -0.340, rx: 0.068, rz: 0.070 },
            { y: -0.180, rx: 0.082, rz: 0.084 },
            { y: -0.040, rx: 0.095, rz: 0.096 },
            { y:  0.045, rx: 0.086, rz: 0.086 },
            { y:  0.090, rx: 0.042, rz: 0.045 }
          ], 28),
          mats.shell, mats.lineFaint, 24
        );
        upperArm.position.x = side * 0.015;
